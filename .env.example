NEXT_PUBLIC_SUPABASE_URL=https://ecaoxnaokkjlotklquip.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
# Public catalogue access uses the publishable key; payment and email workers require the server-only key below.

# Contact form: leave unset until the business approves the inbox and sender domain.
# The sender must be an email address on your verified Resend domain.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# Restrict the Turnstile widget to your storefront hostname(s).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Approved public business destinations; absent links stay hidden.
WHATSAPP_NUMBER=
FACEBOOK_URL=
INSTAGRAM_URL=
TIKTOK_URL=

# Transactional order emails (server-side only).
ORDER_FROM_EMAIL=
ORDER_ADMIN_EMAIL=
# HTTPS canonical storefront origin, used in authenticated email links.
NEXT_PUBLIC_SITE_URL=
# Server-only secret/service-role key for restricted payment and email operations.
SUPABASE_SECRET_KEY=
# Authenticate scheduled GET /api/internal/order-emails with Bearer <secret>.
CRON_SECRET=
# Verify Resend delivery/bounce webhooks; obtain in the provider dashboard.
RESEND_WEBHOOK_SECRET=

# PayHere: use the secret for the exact approved integration domain.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
# Must be explicitly sandbox or production. No automatic live-mode fallback.
PAYHERE_MODE=
# Enable new card handoffs only after reviewing credentials/domain/callback configuration.
PAYHERE_CHECKOUT_ENABLED=false
# Reuse ORDER_FROM_EMAIL / ORDER_ADMIN_EMAIL for transactional email; do not add aliases.
# Approved canonical production origin: https://softhaven.lk
# In preview use the approved preview HTTPS origin instead, never production callback URLs.
